{
  "version": "2.0.0-draft.3",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/haiprotocol/haip.git"
  },
  "homepage": "https://haiprotocol.com",
  "files": [
    "dist",
    "contracts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "name": "@haip/protocol",
  "description": "HAIP 2 draft protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./schema.json": "./contracts/schema.json",
    "./openapi.json": "./contracts/openapi.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "default": "./dist/crypto.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "default": "./dist/json.js"
    }
  }
}
