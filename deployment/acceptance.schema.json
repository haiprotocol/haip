{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haiprotocol.com/schemas/deployment-acceptance-v1.json",
  "title": "HAIP deployment acceptance",
  "oneOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/report"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "checkId": {
      "enum": [
        "origins_tls",
        "external_identity",
        "writer_permissions",
        "immutable_storage",
        "duplicate_conflict",
        "outage_expiry",
        "backup_recovery",
        "notifications",
        "operations",
        "restart_rollback"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "require_clean"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "require_clean": {
          "type": "boolean"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "region", "revision"],
      "properties": {
        "kind": {
          "enum": [
            "runtime",
            "database",
            "identity",
            "anchor",
            "backup",
            "notifications",
            "monitoring"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "identity_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "protocol_revision",
        "configuration_revision",
        "service_artifact_digest",
        "trusted_origin",
        "sandbox_origin_pattern",
        "runtime_identity_label",
        "storage_administrator_label",
        "independent_administration_asserted",
        "components"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "protocol_revision": {
          "const": "2.0.0-draft.3"
        },
        "configuration_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "service_artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "trusted_origin": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "sandbox_origin_pattern": {
          "type": "string",
          "pattern": "^https://[^/?#]*\\{scope\\}[^/?#]*$",
          "maxLength": 2048
        },
        "runtime_identity_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "storage_administrator_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "independent_administration_asserted": {
          "type": "boolean"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "planCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "timeout_ms"],
      "properties": {
        "id": {
          "$ref": "#/$defs/checkId"
        },
        "command": {
          "oneOf": [
            {
              "$ref": "#/$defs/command"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 900000
        },
        "unrun_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "unrun_reason": {}
            },
            "required": ["unrun_reason"]
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "schema_version",
        "source",
        "deployment",
        "adapter_env",
        "secret_env",
        "checks"
      ],
      "properties": {
        "document_type": {
          "const": "plan"
        },
        "schema_version": {
          "const": "haip.deployment.acceptance.v1"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "deployment": {
          "$ref": "#/$defs/deployment"
        },
        "adapter_env": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
          }
        },
        "secret_env": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
          }
        },
        "checks": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/planCheck"
          }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed", "detail"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,119}$"
        },
        "passed": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest", "recorded_at"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "factValue": {
      "type": ["string", "number", "integer", "boolean", "null"]
    },
    "facts": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,119}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/factValue"
      }
    },
    "adapterResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "assertions", "evidence", "facts"],
      "properties": {
        "status": {
          "enum": ["passed", "failed", "blocked"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "assertions": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "facts": {
          "$ref": "#/$defs/facts"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "assertions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "allOf": [
                    {
                      "$ref": "#/$defs/assertion"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "passed": {
                          "const": true
                        }
                      }
                    }
                  ]
                }
              },
              "evidence": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "reportCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "summary",
        "started_at",
        "completed_at",
        "assertions",
        "evidence",
        "facts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/checkId"
        },
        "status": {
          "enum": ["passed", "failed", "blocked", "unrun"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "assertions": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "facts": {
          "$ref": "#/$defs/facts"
        },
        "diagnostic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "assertions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "allOf": [
                    {
                      "$ref": "#/$defs/assertion"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "passed": {
                          "const": true
                        }
                      }
                    }
                  ]
                }
              },
              "evidence": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "blocked", "unrun", "accepted"],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "blocked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "unrun": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "reportSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "schema_version",
        "generated_at",
        "source",
        "deployment",
        "adapter_env",
        "checks",
        "summary",
        "redactions"
      ],
      "properties": {
        "document_type": {
          "const": "report"
        },
        "schema_version": {
          "const": "haip.deployment.acceptance.v1"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "$ref": "#/$defs/reportSource"
        },
        "deployment": {
          "$ref": "#/$defs/deployment"
        },
        "adapter_env": {
          "type": "array",
          "maxItems": 101,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
          }
        },
        "checks": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/reportCheck"
          }
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "redactions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count"],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
