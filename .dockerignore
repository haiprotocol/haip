# Allow only current package/build inputs into the build context. Credentials,
# local evidence, tests, research, archives and Git metadata are excluded by default.
**
!Dockerfile
!package.json
!package-lock.json
!tsconfig.json
!@types/
!@types/package.json
!@types/tsconfig.json
!@types/LICENSE
!@types/README.md
!@types/src/
!@types/src/**
!haip-view/
!haip-view/package.json
!haip-view/tsconfig.json
!haip-view/LICENSE
!haip-view/README.md
!haip-view/src/
!haip-view/src/**
!haip-sdk/
!haip-sdk/package.json
!haip-sdk/tsconfig.json
!haip-sdk/LICENSE
!haip-sdk/README.md
!haip-sdk/src/
!haip-sdk/src/**
!haip-server/
!haip-server/package.json
!haip-server/tsconfig.json
!haip-server/tsconfig.browser.json
!haip-server/LICENSE
!haip-server/README.md
!haip-server/src/
!haip-server/src/**
!haip-server/migrations/
!haip-server/migrations/*.sql
!haip-server/public/
!haip-server/public/index.html
!haip-server/public/style.css
!haip-cli/
!haip-cli/package.json
!haip-cli/tsconfig.json
!haip-cli/LICENSE
!haip-cli/README.md
!haip-cli/src/
!haip-cli/src/**
!protocol/
!protocol/draft-2.0.0-3/
!protocol/draft-2.0.0-3/**
!third-party/
!third-party/*LICENSE
!third-party/README.md
!scripts/
!scripts/generate.mjs
!scripts/openapi.mjs
!scripts/build-browser.mjs

# These final exclusions also cover stray private files inside an allowed source tree.
**/.env*
**/*.pem
**/*.key
**/node_modules/
**/.local/
